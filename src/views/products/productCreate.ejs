<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    
    <main class="main-container auth-main">
        <section class="auth-card" style="max-width: 440px; margin: 0 auto;">
            <h2>Crear Producto</h2>
            <p class="auth-subtitle">Ingresa los datos del nuevo producto</p>

            <form action="/products" method="POST" class="auth-form">
                <!-- Nombre del producto -->
                <div class="form-group">
                    <input type="text" name="name" placeholder="Nombre del producto (ej: Placa RTX 4090)" required class="form-input">
                </div>

                <!-- Precio -->
                <div class="form-group">
                    <input type="number" name="price" placeholder="Precio (ej: 450000)" required class="form-input">
                </div>

                <!-- Categoría -->
                <div class="form-group">
                    <input type="text" name="category" placeholder="Categoría" value="Placas de Video" required class="form-input">
                </div>

                <!-- Descripción -->
                <div class="form-group">
                    <textarea name="description" placeholder="Descripción detallada del producto..." class="form-input" rows="3" style="resize: vertical;"></textarea>
                </div>

                <!-- Selección de imagen -->
                <div class="form-group" style="text-align: left;">
                    <label style="font-size: 0.85rem; color: #555; display: block; margin-bottom: 5px;">Imagen del producto:</label>
                    <select name="image" class="form-input">
                        <option value="Placa RTX 4060.jpg">Placa RTX 4060</option>
                        <option value="Placa RTX 4070.jpg">Placa RTX 4070</option>
                        <option value="Placa RX 7600.jpg">Placa RX 7600</option>
                        <option value="Placa RTX 4080.jpg">Placa RTX 4080</option>
                    </select>
                </div>

                <!-- Botón de Envío -->
                <button type="submit" class="btn-primary-large">Guardar Producto</button>
            </form>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
