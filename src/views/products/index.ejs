<!DOCTYPE html>
<html lang="es">
    <!-- Incluimos el head -->
    <%- include('../partials/head') %>

<body>
    <!-- Incluimos el header y la barra de búsqueda -->
    <%- include('../partials/header') %>

    <main class="main-container">
        
        <!-- 3. BANNER PRINCIPAL (HERO) -->
        <section class="hero-banner">
            <h2>OFERTAS EN PLACAS DE VIDEO</h2>
        </section>

        <!-- 4. SECCIÓN DE PRODUCTOS DESTACADOS -->
        <section class="featured-products">
            <h2>Destacados</h2>

            <!-- Bucle que lee los productos desde el JSON -->
            <div class="products-grid">
                <% products.forEach(product => { %>
                    <article class="product-card">
                        <div class="product-img-container">
                            <img src="/images/<%= product.image %>" alt="<%= product.name %>" class="product-img">
                        </div>
                        <div class="product-info">
                            <h3><%= product.name %></h3>
                            <p class="price">$ <%= product.price.toLocaleString('es-AR') %></p>
                            <a href="/products/<%= product.id %>" class="btn-buy">Ver / Comprar</a>
                        </div>
                    </article>
                <% }) %>
            </div>

        </section>

    </main>

    <!-- Incluimos el footer -->
    <%- include('../partials/footer') %>

</body>
</html>
