<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>

    <!-- ENCABEZADO -->
    <%- include('../partials/header') %>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-container detail-container">
        
        <!-- Imagen del producto -->
        <div class="detail-img-card">
            <img src="/images/<%= product.image %>" alt="<%= product.name %>" class="detail-img">
        </div>

        <!-- Título y Precios -->
        <h2 class="product-title"><%= product.name %></h2>
        <div class="product-price-box">
            <span class="price-tag">$ <%= product.price.toLocaleString('es-AR') %></span>
            <span class="installments">6 cuotas fijas de $ <%= Math.round(product.price / 6).toLocaleString('es-AR') %></span>
        </div>

        <!-- Descripción del producto -->
        <% if (product.description) { %>
            <div style="background: #fff; padding: 12px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                <p style="font-size: 0.9rem; color: #444; line-height: 1.4;"><%= product.description %></p>
            </div>
        <% } %>

        <!-- Selector de cantidad -->
        <div class="quantity-selector">
            <button type="button" class="qty-btn">-</button>
            <span class="qty-number">1</span>
            <button type="button" class="qty-btn">+</button>
        </div>

        <!-- Botón de compra -->
        <button type="button" class="btn-primary-large">Agregar al Carrito</button>

        <!-- Acciones de Administración (Edición y Eliminación) -->
        <div style="display: flex; gap: 10px; margin-top: 10px;">
            <a href="/products/<%= product.id %>/edit" class="btn-primary-large" style="background-color: #2b70c9; text-decoration: none; flex: 1; text-align: center; display: flex; align-items: center; justify-content: center;">
                ✏️ Editar
            </a>
            <form action="/products/<%= product.id %>?_method=DELETE" method="POST" style="flex: 1;" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este producto permanentemente?');">
                <button type="submit" class="btn-primary-large" style="background-color: #d9534f; width: 100%;">
                    🗑️ Eliminar
                </button>
            </form>
        </div>

        <!-- Especificaciones Técnicas comunes -->
        <section class="tech-specs">
            <h3>Especificaciones Técnicas</h3>
            <div class="spec-row">
                <span class="spec-name">Categoría</span>
                <span class="spec-value"><%= product.category %></span>
            </div>
            <div class="spec-row">
                <span class="spec-name">Chipset / Modelo</span>
                <span class="spec-value"><%= product.name %></span>
            </div>
            <div class="spec-row">
                <span class="spec-name">Garantía</span>
                <span class="spec-value">12 Meses Oficial</span>
            </div>
            <div class="spec-row">
                <span class="spec-name">Envío</span>
                <span class="spec-value">A todo el país</span>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <%- include('../partials/footer') %>

</body>
</html>
